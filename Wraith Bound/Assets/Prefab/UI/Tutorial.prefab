--- !u!114 &3650951505023850637
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3069103899323302840}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 334d8b3a87c51b0469d508132629175b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  showEveryTime: 1
  startDelayWithoutStarter: 1
  steps:
  - condition: 0
    keyLabel: WASD
    message: "\uC8FC\uBCC0\uC744 \uAC78\uC5B4\uC11C \uC774\uB3D9\uD558\uC138\uC694"
    requiredAmount: 3
    highlightTarget: 0
  - condition: 1
    keyLabel: Shift
    message: "Shift\uB97C \uB204\uB978 \uCC44 \uC55E\uC73C\uB85C \uB2EC\uB9AC\uC138\uC694"
    requiredAmount: 1
    highlightTarget: 0
  - condition: 2
    keyLabel: Ctrl
    message: "Ctrl\uC744 \uB204\uB978 \uCC44 \uC6C5\uD06C\uB9AC\uC138\uC694"
    requiredAmount: 0.75
    highlightTarget: 0
  - condition: 3
    keyLabel: F
    message: "F\uB97C \uB20C\uB7EC \uCEA0\uCF54\uB354\uB97C \uAEBC\uB0B4\uC138\uC694"
    requiredAmount: 0
    highlightTarget: 0
  - condition: 4
    keyLabel: "\uC88C\uD074\uB9AD"
    message: "\uC88C\uD074\uB9AD\uC73C\uB85C \uBDF0\uD30C\uC778\uB354\uB97C \uCF1C\uC138\uC694\n\uC5B4\uB460
      \uC18D\uC744 \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4"
    requiredAmount: 0
    highlightTarget: 0
  - condition: 5
    keyLabel: "\uD720"
    message: "\uB9C8\uC6B0\uC2A4 \uD720\uB85C \uC90C\uC744 \uC870\uC808\uD558\uC138\uC694"
    requiredAmount: 2
    highlightTarget: 0
  - condition: 6
    keyLabel: F
    message: "F\uB97C \uB20C\uB7EC \uCEA0\uCF54\uB354\uB97C \uC9D1\uC5B4\uB123\uC73C\uC138\uC694"
    requiredAmount: 0
    highlightTarget: 0
  - condition: 7
    keyLabel: E
    message: "\uC55E\uC758 \uB370\uC2A4\uD06C\uC5D0 \uB193\uC778 \uC190\uC804\uB4F1\uC744
      \uC8FC\uC6B0\uC138\uC694"
    requiredAmount: 0
    highlightTarget: 1
  - condition: 8
    keyLabel: "1~3 / \uD720"
    message: "\uC22B\uC790\uD0A4\uB098 \uB9C8\uC6B0\uC2A4 \uD720\uB85C \uC190\uC804\uB4F1\uC744
      \uC120\uD0DD\uD558\uC138\uC694"
    requiredAmount: 0
    highlightTarget: 0
  - condition: 9
    keyLabel: "\uC88C\uD074\uB9AD"
    message: "\uC88C\uD074\uB9AD\uC73C\uB85C \uC190\uC804\uB4F1\uC744 \uCF1C\uC138\uC694"
    requiredAmount: 0
    highlightTarget: 0
  - condition: 10
    keyLabel: Tab
    message: "Tab\uC73C\uB85C \uC778\uBCA4\uD1A0\uB9AC\uB97C \uD3BC\uCCD0 \uBCF4\uC138\uC694"
    requiredAmount: 0
    highlightTarget: 0
  tips:
  - trigger: 0
    title: "\uC544\uC774\uD15C \uC0AC\uC6A9"
    message: "\uC22B\uC790\uD0A4\uB098 \uB9C8\uC6B0\uC2A4 \uD720\uB85C \uC544\uC774\uD15C\uC744
      \uC120\uD0DD\uD55C \uB4A4\n<b>\uC6B0\uD074\uB9AD\uC744 \uAE38\uAC8C</b> \uB204\uB974\uBA74
      \uC0AC\uC6A9\uD569\uB2C8\uB2E4."
  - trigger: 1
    title: "\uAC74\uC804\uC9C0"
    message: "\uC190\uC804\uB4F1\uC744 \uC120\uD0DD\uD55C \uC0C1\uD0DC\uC5D0\uC11C
      <b>R</b>\uC744 \uB204\uB974\uBA74\n\uAC74\uC804\uC9C0\uB85C \uC190\uC804\uB4F1\uC744
      \uCDA9\uC804\uD569\uB2C8\uB2E4."
  - trigger: 2
    title: "\uC228\uAE30"
    message: "\uC228\uC744 \uC218 \uC788\uB294 \uACF3\uC785\uB2C8\uB2E4. <b>E</b>\uB85C
      \uB4E4\uC5B4\uAC00 \uC228\uACE0\n\uB2E4\uC2DC <b>E</b>\uB97C \uB204\uB974\uBA74
      \uB098\uC635\uB2C8\uB2E4.\n\uC228\uC5B4 \uC788\uC73C\uBA74 \uC801\uC5D0\uAC8C
      \uB4E4\uD0A4\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  stepCompleteDelay: 0.8
  finishMessageDuration: 2.5
  finishMessage: "\uD29C\uD1A0\uB9AC\uC5BC \uC644\uB8CC\n\uC5B4\uB460 \uC18D\uC5D0\uC11C
    \uC0B4\uC544\uB0A8\uC73C\uC138\uC694"
  skipHoldDuration: 2
  promptUI: {fileID: 418249655596941990}
  tipPopup: {fileID: 9127560481846206837}
  highlight: {fileID: 2169396134855977230}
