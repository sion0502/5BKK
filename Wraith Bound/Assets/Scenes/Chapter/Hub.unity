MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1488639852}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd128b503ccfc434d93e7879974070e6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryDocumentPickup
  documentId: hub_note
  prompt: "[E] \uCABD\uC9C0 \uC77D\uAE30"
  title: "\uB204\uAD70\uAC00\uC758 \uCABD\uC9C0"
  body: "\uC774 \uCABD\uC9C0\uB97C \uC77D\uACE0 \uC788\uB2E4\uBA74, \uB2F9\uC2E0\uB3C4
    \uC8FD\uC5C8\uB2E4\uAC00 \uC774\uACF3\uC5D0\uC11C \uB208\uC744 \uB5B4\uACA0\uC9C0.\n\n\uC5EC\uAE30\uB294
    \uADC0\uBB38(\u9B3C\u9580)\uC758 \uBC29. \uC774 \uC12C\uC5D0\uC11C \uC8FD\uC740
    \uC790\uB294 \uC774\uACF3\uC73C\uB85C \uB3CC\uC544\uC628\uB2E4. \uBA87 \uBC88\uC774\uB4E0.\n\n\uBB38\uC740
    \uC14B. \uC9C0\uAE08 \uC5F4\uB9AC\uB294 \uAC74 \uD558\uB098\uBFD0\uC774\uB2E4.\n\uADF8
    \uB108\uBA38 \uBCD1\uC6D0 \uC5B4\uB518\uAC00\uC5D0 \uBD09\uC778\uC744 \uD478\uB294
    \uC5F4\uC1E0 \uC138 \uAC1C\uAC00 \uC788\uB2E4.\n\n\uC8FD\uC73C\uBA74 \uC190\uC5D0
    \uC954 \uAC83\uC740 \uBAA8\uB450 \uC783\uB294\uB2E4. \uB0B4\uAC00 \uB0A8\uAE34
    \uAE30\uB85D\uB9CC\uC774 \uB0A8\uB294\uB2E4.\n\n\u2014 \uAE30\uB85D\uC790"
  removeAfterReading: 0
