  m_Script: {fileID: 11500000, guid: bd128b503ccfc434d93e7879974070e6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryDocumentPickup
  documentId: journal_00
  prompt: "[E] \uC77C\uC9C0 \uC77D\uAE30"
  title: "\uAE30\uB85D \u2014 10\uC6D4 3\uC77C"
  body: "\uBB34\uB2F9\uC774 \uC8FD\uC5C8\uB2E4. \uC0AC\uACE0\uC600\uB2E4. \uB204\uAD6C\uB3C4
    \uC6D0\uD558\uC9C0 \uC54A\uC558\uB2E4.\n\uC228\uC774 \uB04A\uC5B4\uC9C0\uAE30
    \uC804, \uADF8 \uB178\uC778\uC740 \uB098\uB97C \uB611\uBC14\uB85C \uBCF4\uBA70
    \uB9D0\uD588\uB2E4.\n\n<i>\"\uC774 \uC12C\uC5D0 \uBC1C\uC744 \uB4E4\uC600\uB358
    \uC790\uB294, \uBAA8\uB450 \uC8FD\uB294\uB2E4.\"</i>\n\n\uADF8\uB0A0 \uBC24\uBD80\uD130
    \uBCD1\uB3D9\uC5D0\uC11C \uC18C\uB9AC\uAC00 \uB09C\uB2E4.\n3\uBCD1\uB3D9 \uAC04\uD638\uC0AC\uAC00
    \uCD9C\uADFC\uD558\uC9C0 \uC54A\uC558\uB2E4. \uC544\uB2C8, \uCD9C\uADFC\uD588\uB2E4.\n\uBCF5\uB3C4
    \uB05D\uC5D0 \uC11C \uC788\uB294 \uAC78 \uBD24\uB2E4. \uAE30\uB85D\uC6A9 \uCEA0\uCF54\uB354
    \uD654\uBA74 \uC18D\uC5D0\uC11C\uB9CC."
  removeAfterReading: 1
